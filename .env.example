# Copy to .env to override the Compose defaults. Every value is optional.

# Postgres (local demo database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aila

# Host port for the API
API_PORT=8000

# Worker simulation: each job sleeps MIN..MAX seconds, then fails with probability FAIL_RATE
MIN_DELAY_SECONDS=3
MAX_DELAY_SECONDS=60
FAIL_RATE=0.2

# Worker reliability
CONCURRENCY=8
CLAIM_BATCH=10
MAX_ATTEMPTS=3
PROCESSING_TIMEOUT_SECONDS=300

# Only read when running the API outside Docker (from backend/, via pydantic-settings)
# DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/aila
